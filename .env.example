# ========== GOOGLE DRIVE OAUTH ==========
# Get from: https://console.cloud.google.com/apis/dashboard
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-drive/callback

# ========== VERCEL DEPLOYMENT ==========
# Get from: https://vercel.com/account/tokens
VERCEL_API_TOKEN=your_vercel_api_token_here

# ========== NETLIFY DEPLOYMENT ==========
# Get from: https://app.netlify.com/user/applications
NETLIFY_AUTH_TOKEN=your_netlify_auth_token_here

# ========== CLOUDFLARE PAGES DEPLOYMENT ==========
# Get from: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# ========== RPC PROVIDERS ==========
INFURA_API_KEY=your_infura_api_key_here
ALCHEMY_API_KEY=your_alchemy_api_key_here
QUICKNODE_API_URL=https://your-quicknode-endpoint.quiknode.pro/

# ========== CAPTCHA SOLVING ==========
CAPTCHA_API_KEY=your_2captcha_api_key_here

# ========== AI & ANALYTICS ==========
OPENAI_API_KEY=your_openai_api_key_here

# ========== APP CONFIG ==========
NEXT_PUBLIC_APP_NAME=AutoPilot Testnet AI
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
